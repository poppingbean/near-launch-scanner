# Copy to .env and fill in. .env is git-ignored. Never share or commit it.

# ---------- Wallet (only needed for live trading) ----------
NEAR_ACCOUNT_ID=
# Full-access or function-call key in the form ed25519:<base58>. Keep this file private.
NEAR_PRIVATE_KEY=

# ---------- Live trading switches (both required to send real transactions) ----------
DRY_RUN=true
# Set exactly to I_UNDERSTAND_THE_RISK together with DRY_RUN=false to trade for real.
ENABLE_LIVE_TRADING=

# ---------- Spend limits (hard caps) ----------
# Tranche 1 is bought as soon as the hard rules pass; tranche 2 only after the AI review approves.
FIRST_TRANCHE_NEAR=2
SECOND_TRANCHE_NEAR=3
# Don't buy tranche 2 if the price rose more than this fraction while the AI was reviewing (0.5 = +50%).
MAX_TRANCHE2_PRICE_RISE=0.5
MAX_TOTAL_SPEND_NEAR=50
# Max number of new tokens entered per 24 h (tranche-2 top-ups do not count).
MAX_BUYS_PER_DAY=10
MIN_NEAR_RESERVE=3
SLIPPAGE_BPS=1000

# ---------- Take profit ----------
# When ROI > TAKE_PROFIT_ROI (3 = +300%), sell just enough to receive TAKE_PROFIT_WITHDRAW_NEAR and hold the rest (once per token).
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_ROI=3
TAKE_PROFIT_WITHDRAW_NEAR=2.5
POSITION_CHECK_SECONDS=30
# The AI recommends BUY_MORE (add tranche 2), HOLD (keep the starter bag) or SELL (exit now).
# When the review can't run (error / timeout), do this with the starter bag: sell | hold
AI_FAILURE_ACTION=sell

# ---------- AI review (Claude) ----------
# cli (default): runs the local Claude Code CLI (`claude -p`) on your Claude subscription login - no API cost.
#   One-time setup: open a terminal, run `claude`, then /login with your Claude account.
#   The scanner strips CLAUDE*/ANTHROPIC* env vars and ignores ~/.claude/settings.json provider overrides,
#   so the review always uses that login. CLAUDE_CLI_SETTING_SOURCES=user re-enables your user settings.
# api: Anthropic API, billed per token; needs ANTHROPIC_API_KEY.
AI_BACKEND=cli
# CLAUDE_CLI_PATH=
AI_CLI_TIMEOUT_SECONDS=300
AI_MAX_CONCURRENT=2
# Hold back tranche-1 buys while the AI health check fails (re-checked every 10 min).
REQUIRE_AI_READY=true
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-opus-5-5
AI_EFFORT=high
AI_MIN_CONFIDENCE=0.65

# ---------- Scanning ----------
LAUNCHPADS=nearlytrade,justhoot,memecooking,gaypad
# Pool quote tokens that can be bought: wNEAR (direct), NEARLY (DCL multi-hop), RHEA (via Ref v2 pool 6458).
ACCEPTED_QUOTES=wrap.near,nearly-993927.nearlytrade.near,token.rhealab.near
POLL_SECONDS=15
OBSERVE_SECONDS=300
JUSTHOOT_MIN_AGE_SECONDS=240
MAX_TOKEN_AGE_MINUTES=60

# ---------- Rule thresholds ----------
MIN_POOL_NEAR=20
MIN_UNIQUE_BUYERS=5
MAX_TAX_BPS=1000
MAX_LINKED_BUYER_SHARE=0.4
MAX_PRICE_MULTIPLE=8
# The run-up check above only applies once the fully diluted market cap reaches this many USD.
IGNORE_RUNUP_BELOW_MCAP_USD=10000
MIN_RULE_SCORE=55

# ---------- Monitor UI ----------
# http://localhost:8787 (local only). 0 disables.
DASHBOARD_PORT=8787

# ---------- Data sources (optional) ----------
# NEAR_RPC_URLS=https://rpc.mainnet.fastnear.com,https://free.rpc.fastnear.com
# FASTNEAR_API_KEY=
